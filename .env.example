# Copy this file to .env and fill in your values:  cp .env.example .env
# (Or run `python3 setup.py`, which writes .env for you.)
# The real .env is git-ignored and must never be committed.

# --- API keys ---
ELEVENLABS_API_KEY=your_elevenlabs_key          # elevenlabs.io -> Developers -> API Keys
ANTHROPIC_API_KEY=your_anthropic_key            # console.anthropic.com -> API Keys
YOUTUBE_API_KEY=your_youtube_data_api_key       # Google Cloud -> YouTube Data API v3

# --- Cloudflare R2 (S3-compatible storage) ---
R2_ACCOUNT_ID=your_32_char_account_id           # R2 dashboard / S3 endpoint
R2_ACCESS_KEY_ID=your_r2_access_key             # R2 -> Manage API Tokens (Object Read & Write)
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_BUCKET=podcast                               # your bucket name
R2_PUBLIC_BASE=https://pub-xxxxxxxx.r2.dev      # bucket public URL (r2.dev or custom domain)

# --- YouTube queue ---
PLAYLIST_ID=PLxxxxxxxxxxxx                       # the list= value of your "to summarize" playlist
                                                 # (must be Public or Unlisted, not Private)
