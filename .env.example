# Copy this file to .env and fill in your values:  cp .env.example .env
# (Or run `python3 setup.py`, which writes .env for you.)
# The real .env is git-ignored and must never be committed.

# --- API keys ---
ELEVENLABS_API_KEY=your_elevenlabs_key          # elevenlabs.io -> Developers -> API Keys
ANTHROPIC_API_KEY=your_anthropic_key            # console.anthropic.com -> API Keys
YOUTUBE_API_KEY=your_youtube_data_api_key       # Google Cloud -> YouTube Data API v3

# --- Optional: use your Claude subscription instead of an API key ---
# Off by default. To turn it on: run `claude setup-token` on your own machine,
# put the token below, and DELETE the ANTHROPIC_API_KEY line above. Never set
# both: the API key takes priority, so you would still pay per token, and the
# pipeline refuses to start rather than let that happen silently.
# Use your OWN plan and your own token, never someone else's. The token lasts
# one year. Usage counts against your plan's limits, and Anthropic says plan
# limits assume ordinary individual use, so heavy automated use should stay on
# an API key. https://code.claude.com/docs/en/legal-and-compliance
# CLAUDE_CODE_OAUTH_TOKEN=your_token_from_claude_setup_token

# --- Cloudflare R2 (S3-compatible storage) ---
R2_ACCOUNT_ID=your_32_char_account_id           # R2 dashboard / S3 endpoint
R2_ACCESS_KEY_ID=your_r2_access_key             # R2 -> Manage API Tokens (Object Read & Write)
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_BUCKET=podcast                               # your bucket name
R2_PUBLIC_BASE=https://pub-xxxxxxxx.r2.dev      # bucket public URL (r2.dev or custom domain)

# --- Source audio clips (OFF by default) ---
# Set to 1 to let episodes include short excerpts of the ORIGINAL audio, cut
# from the source video and played between narration.
#
# Read this before switching it on. Publishing an AI paraphrase and publishing
# someone else's actual audio are different positions. Short, illustrative
# excerpts inside original commentary, with the source credited and linked, is
# the strongest form of the argument, and it is what this code does: it caps
# clips at 15s each and 45s per episode, and asks for passages that illustrate
# the speaker's argument rather than the single most quotable line.
#
# None of that is legal advice, and attribution alone is not a copyright
# defence. The safest posture is a private feed. Downloading the audio also
# conflicts with YouTube's Terms of Service regardless of copyright. Your call.
CLIPS_ENABLED=0

# --- YouTube queue ---
PLAYLIST_ID=PLxxxxxxxxxxxx                       # the list= value of your "to summarize" playlist
                                                 # (must be Public or Unlisted, not Private)
